# ---------------------------------------------------------------
# Lead delivery — where "Start a project" (/start) funnel leads go.
# ---------------------------------------------------------------

# PRIMARY: Web3Forms. Delivery happens in the BROWSER — their free plan
# rejects server-to-server calls — so these MUST be NEXT_PUBLIC_.
# That's by design: a Web3Forms access key is public and only permits
# submitting to your own form.
#
# ONE KEY = ONE INBOX. Web3Forms binds a key to a single receiving address,
# so multi-recipient = multi-key: the funnel submits once per key and every
# configured inbox gets its own copy. Create each key at https://web3forms.com
# against the address that should receive it.
NEXT_PUBLIC_WEB3FORMS_KEY=        # inbox 1 (e.g. zain@thekhanstruct.com)
NEXT_PUBLIC_WEB3FORMS_KEY_2=      # inbox 2
NEXT_PUBLIC_WEB3FORMS_KEY_3=      # inbox 3 (optional)

# Inbox used by the server-side log/backup path.
LEAD_INBOX=zain@thekhanstruct.com

# OPTIONAL backup: also send server-side via Resend (needs a verified domain).
RESEND_API_KEY=
LEAD_FROM="Khanstruct <hello@thekhanstruct.com>"

# ---------------------------------------------------------------
# Optional CRM — writes each lead to a Notion database.
# Dormant until both are set. Fire-and-forget; never blocks the visitor.
# Expected DB properties: Name(title), Email(email), Company(text),
# Priority(select), Recommended(text), Timeline(text), Budget(text)
# ---------------------------------------------------------------
NOTION_TOKEN=
NOTION_DB_ID=

# ---------------------------------------------------------------
# Contact form (the simpler /contact page)
# ---------------------------------------------------------------
TURNSTILE_SECRET_KEY=
